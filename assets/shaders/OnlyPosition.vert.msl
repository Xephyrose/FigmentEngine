#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 gl_Position [[position]];
};

struct main0_in
{
    float in_var_POSITION0 [[attribute(0)]];
    float in_var_POSITION1 [[attribute(1)]];
    float in_var_POSITION2 [[attribute(2)]];
};

vertex main0_out main0(main0_in in [[stage_in]])
{
    main0_out out = {};
    out.gl_Position = float4(in.in_var_POSITION0, in.in_var_POSITION1, in.in_var_POSITION2, 1.0);
    return out;
}

